# Local-only material is ignored by folder. Keep anything private inside one of these folders.
/workspace/
private/

# Environments, builds and caches
.venv/
node_modules/
dist/
build/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# AI instruction files, translations and tool folders are local-only at every depth.
AGENTS.md
AGENTS.KO.md
AGENTS.override.md
AGENTS.override.KO.md
AGENTS.local.md
.agents.md
CLAUDE.md
CLAUDE.KO.md
CLAUDE.local.md
GEMINI.md
GEMINI.KO.md
GEMINI.local.md
.agents/
.agent/
_agents/
_agent/
.claude/
.codex/
.gemini/

# Files that no folder rule can cover
/config/*.local.*
/config/*.private.*
/config/*-local.*
/config/*-private.*
/connector-targets.*
.env
.env.*
.DS_Store
Thumbs.db
*.pyc

# Safety net for clones: credentials, browser sessions, local databases and logs
*.pem
*.key
*.p12
*.pfx
credentials/
sessions/
.job-research-match/
playwright/.auth/
storage-state*.json
*.auth.json
*.session.json
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.log

# Generated run output and captures, if a tool writes them inside a clone
data/
output/
reports/
tmp/
profiles/
attachments/
screenshots/
